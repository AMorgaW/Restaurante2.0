# Restaurante2.0 — variables de entorno (placeholders; sin secretos reales)
# Copia a .env.local (ignorado por Git). Nunca subas valores reales.
# No compartas contraseñas, tokens ni claves en el chat ni en commits.

# Auth y datos se resuelven de forma independiente.
# AUTH_MODE es obligatorio en todos los entornos (sin fallback implícito).
# development|test + AUTH_MODE=disabled → harness demo explícito.
# production solo admite AUTH_MODE=supabase con URL y publishable key válidas.
# production + disabled|ausente|demo → invalid.
# disabled | supabase
AUTH_MODE=disabled
# local | supabase
DATA_MODE=local

# Recuperación durable de comprobantes de invitados (C2.2).
# Debe permanecer false hasta desplegar 0016 en el mismo entorno Supabase.
GUEST_RECEIPT_RECOVERY_ENABLED=false

# URL pública de la app (Site URL / redirects de Auth).
# Productiva: pendiente de dominio de despliegue inequívoco; usar localhost en local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth SSR — solo clave publicable (navegador + Server Components).
# Nunca uses sb_secret_ ni service_role en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Compatibilidad temporal: JWT anon legado de Supabase CLI local.
# Preferir siempre PUBLISHABLE_KEY. No uses esta variable en producción.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recovery: plantilla Auth con {{ .RedirectTo }}?token_hash={{ .TokenHash }}
# Callback PKCE: /auth/callback
# Actualización de contraseña: /actualizar-contrasena

# SOLO servidor — webhooks firmados (Stripe). NO para Auth SSR ni bootstrap de owner.
# El primer owner se crea en Dashboard + SQL Editor (ver references/runbooks/FIRST_OWNER_BOOTSTRAP.md).
# SUPABASE_SERVICE_ROLE_KEY=

# Harness contra Supabase CLI LOCAL (solo procesos Node de prueba).
# El helper obtiene estos valores con `supabase status -o json` cuando el stack está activo.
# Defínelos manualmente solo como override local/CI; nunca uses credenciales productivas aquí.
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_PUBLISHABLE_KEY=
SUPABASE_LOCAL_ANON_KEY=
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
# Opcional: si queda vacío, el harness genera una contraseña efímera por proceso.
SUPABASE_LOCAL_TEST_PASSWORD=

# Pagos reales deshabilitados por defecto.
# demo | stripe | mercadopago
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# none | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Brisas del Sinú <noreply@example.com>"

# off | debug
NEXT_PUBLIC_ANALYTICS=off
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
