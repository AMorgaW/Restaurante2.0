# Restaurante2.0 - variables de entorno de ejemplo (sin secretos reales)
# La aplicacion funciona como demo invitado si AUTH_MODE y DATA_MODE no existen.
# Nunca subas .env.local al repositorio.

# Auth y datos se resuelven de forma independiente.
# disabled | supabase
AUTH_MODE=disabled
# local | supabase
DATA_MODE=local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: requeridas si AUTH_MODE=supabase o DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad transitoria; PUBLISHABLE_KEY tiene prioridad.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recovery usa token_hash de un solo uso. Al conectar Supabase, configura la
# plantilla Recovery con: {{ .RedirectTo }}?token_hash={{ .TokenHash }}

# Exclusiva de servidor. Solo para operaciones privilegiadas auditadas.
SUPABASE_SERVICE_ROLE_KEY=

# Pagos reales siguen deshabilitados; demo no realiza cobros.
# demo | stripe | mercadopago
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# none | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Brisas del Sinú <noreply@example.com>"

# off | debug
NEXT_PUBLIC_ANALYTICS=off
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
