# ============================================================
# Restaurante 2.0 — Variables de entorno
# Copia este archivo a .env.local y completa solo lo que uses.
# La aplicación funciona COMPLETA en modo demo sin ninguna
# de estas variables (DATA_MODE=local es el valor por defecto).
# Nunca subas .env.local al repositorio.
# ============================================================

# --- Modo de datos -------------------------------------------
# local    -> menú desde el manifiesto generado, pedidos/reservas demo (por navegador)
# supabase -> requiere las variables de Supabase de más abajo
DATA_MODE=local

# URL pública del sitio (SEO, sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (solo con DATA_MODE=supabase) ------------------
# Panel: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagos ----------------------------------------------------
# demo | stripe | mercadopago  (demo no realiza cobros reales)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Correo transaccional ------------------------------------
# none | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Casa Brasa <reservas@example.com>"

# --- Analítica y monitoreo (opcionales, desactivados) --------
# off | debug  (debug solo imprime en consola de desarrollo)
NEXT_PUBLIC_ANALYTICS=off
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
