{
  "name": "restaurante-2-0",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web responsive para restaurante (Next.js): menú desde imágenes locales, carrito, pedidos locales/domicilios, pensionados y panel admin; modo demo sin credenciales y adaptadores Supabase.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "predev": "npm run generate:menu",
    "dev": "next dev",
    "prebuild": "npm run generate:menu",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 3100",
    "start:e2e:hydration": "next start -p 3000",
    "dev:e2e": "npm run generate:menu && next dev -p 3100",
    "dev:e2e:hydration": "npm run generate:menu && next dev -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db --local supabase/tests/0001_backend_security.test.sql && supabase test db --local supabase/tests/0010_create_customer_order.test.sql && supabase test db --local supabase/tests/0011_profiles_staff_status_grant.test.sql && supabase test db --local supabase/tests/0012_delivery_inventory.test.sql && supabase test db --local supabase/tests/0013_pension_orders.test.sql && supabase test db --local supabase/tests/0014_manual_payments_dining_tables.test.sql && supabase test db --local supabase/tests/0015_payment_read_models.test.sql",
    "test:db:concurrency": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-supabase-concurrency.ps1",
    "test:e2e": "playwright test --project=mobile-chromium && playwright test --project=mobile-webkit && playwright test --project=desktop",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dining-tables-supabase": "playwright test -c playwright.dining-tables-supabase.config.ts",
    "test:e2e:staff-orders-supabase": "playwright test -c playwright.staff-orders-supabase.config.ts",
    "test:e2e:pension-supabase": "playwright test -c playwright.pension-supabase.config.ts",
    "generate:menu": "tsx scripts/generate-menu-manifest.ts",
    "validate:images": "tsx scripts/validate-images.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run generate:menu && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "lucide-react": "^0.475.0",
    "motion": "^12.0.0",
    "next": "^15.5.0",
    "next-view-transitions": "^0.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.25.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
